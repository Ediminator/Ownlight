{
  "name": "ownlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . && node scripts/lint-actions.mjs",
    "lint:actions": "node scripts/lint-actions.mjs",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:sast": "eslint .",
    "scan:deps": "pnpm audit --audit-level high",
    "scan:licenses": "node scripts/check-licenses.mjs",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:seed:demo": "node scripts/seed-demo.mjs",
    "retention:build": "node scripts/build-retention.mjs",
    "retention:sweep": "node scripts/build-retention.mjs && node dist/retention/cli.mjs",
    "worker": "node scripts/build-retention.mjs && node dist/retention/worker.mjs",
    "services:up": "docker compose -f compose.dev.yml up -d",
    "services:down": "docker compose -f compose.dev.yml down",
    "services:reset": "node scripts/services-reset.mjs",
    "services:logs": "docker compose -f compose.dev.yml logs -f",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@radix-ui/react-avatar": "1.2.7",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-slot": "1.4.0",
    "@simplewebauthn/server": "14.0.3",
    "altcha-lib": "2.6.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.16",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@faker-js/faker": "10.6.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "autoprefixer": "10.6.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "lefthook": "2.2.1",
    "pg-gateway": "0.3.0-beta.4",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.29",
    "prettier": "3.9.9",
    "secretlint": "13.0.7",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
