# ==============================================================================
# Ownlight Production Environment Template for Synology Docker Compose
# Copy this file to .env.synology on your Synology NAS:
#   cp .env.synology.example .env.synology
#
# IMPORTANT SECURITY NOTES:
# 1. Never commit .env.synology to git.
# 2. Generate strong, unique cryptographic keys for each secret below.
# 3. Port 3000 is reserved on the Synology host by self-hosted Gitea.
#    Keep PORT=3030 (or another free port) to prevent service collision.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Port Configuration
# ------------------------------------------------------------------------------
# Host port mapping for Ownlight web service.
# WARNING: Do NOT set to 3000 on Synology NAS if Gitea is running on port 3000!
PORT=3030

# Public or local base URL used by Better-Auth and browser redirects.
# If accessing via Synology Reverse Proxy with SSL: https://ownlight.your-domain.synology.me
# If accessing directly on local LAN: http://<synology-nas-ip>:3030
AUTH_URL=http://<synology-nas-ip>:3030

# Number of reverse proxy hops in front of the application.
# Set to 1 if behind Synology Application Portal / Nginx reverse proxy.
# Set to 0 if accessing directly on port 3030 without a reverse proxy.
TRUSTED_PROXY_COUNT=1

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL database name
POSTGRES_DB=ownlight_prod

# Superuser credentials used only during container init
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_random_postgres_root_password

# Least-Privilege Application Role (DML only: SELECT, INSERT, UPDATE, DELETE)
# Denied CREATE TABLE / ALTER TABLE / DROP TABLE
POSTGRES_APP_USER=ownlight_app
POSTGRES_APP_PASSWORD=replace_with_strong_random_app_password

# Least-Privilege Migration Role (DDL owner: CREATE, ALTER, DROP)
# Used only during startup schema migration execution
POSTGRES_MIGRATOR_USER=ownlight_migrator
POSTGRES_MIGRATOR_PASSWORD=replace_with_strong_random_migrator_password

# ------------------------------------------------------------------------------
# 3. Cryptographic Secrets
# ------------------------------------------------------------------------------
# Better-Auth session signature key (min 32 characters / 256 bits).
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_with_openssl_rand_base64_32_secret

# Initial Setup Bootstrap Token
# Used to claim initial studio owner account at http://<nas-ip>:3030/en/setup.
# Generate with: openssl rand -base64 32
SETUP_TOKEN=replace_with_openssl_rand_base64_32_setup_token

# Field-level AES-256-GCM encryption key for sensitive records at rest.
# Must be exactly 64 hexadecimal characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_characters_aes_256_key_e_g_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 4. Startup & Migrations
# ------------------------------------------------------------------------------
# Automatically run database migrations on container start before launching server.
# Set to 'false' only if migrations are managed out-of-band.
AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# 5. Outbound Email / SMTP (Optional)
# ------------------------------------------------------------------------------
# For production email delivery, configure your SMTP provider (e.g. Resend, Postmark).
# If unconfigured, notification emails will be logged locally without failing operations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=studio@example.com

# ------------------------------------------------------------------------------
# 6. Mailpit SMTP Sink for Staging (Optional)
# ------------------------------------------------------------------------------
# If running with '--profile mailpit' on staging, UI webmail is exposed at:
MAILPIT_HTTP_PORT=8025
