# ==============================================================================
# Ownlight — Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Generate strong secrets using `openssl rand -hex 32` for production or dev.
# 3. .env is gitignored and must NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Environment & Runtime Settings
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# HTTP port for the Next.js application server
PORT=3000

# Canonical public URL of the application (used for redirects and callbacks)
AUTH_URL=http://localhost:3000

# Number of trusted reverse-proxy hops in front of the application server (0-5, default 1).
# Determines client IP from the X-Forwarded-For header as the N-th entry from the right (L[len - N]).
# - 1: Standard deployment behind a single reverse proxy (Caddy reference deployment, Nginx, Traefik)
# - 2: Behind two reverse proxies (e.g. Cloudflare / AWS CloudFront -> Caddy -> Next.js)
# - 0: Direct connection without reverse proxy (maps missing/short headers to 'unknown' bucket)
TRUSTED_PROXY_COUNT=1

# Session signing & auth secret key (Better-Auth)
# MUST be at least 32 bytes (64 hex characters or 44 base64 characters).
# Generate with: openssl rand -hex 32
AUTH_SECRET=changeme_generate_32_bytes_hex_or_base64_secret_key_here

# Initial owner bootstrap setup token (required for /[locale]/setup when no user exists)
# MUST be at least 32 random bytes (64 hex characters).
# Generate with: openssl rand -hex 32
SETUP_TOKEN=changeme_generate_32_bytes_hex_or_base64_setup_token_here

# ------------------------------------------------------------------------------
# PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# Application runtime connection string (Least-privilege DML role: ownlight_app)
# Denied DDL (cannot CREATE/ALTER/DROP tables).
DATABASE_URL=postgres://ownlight_app:password@127.0.0.1:5432/ownlight_dev

# Migration connection string (DDL role: ownlight_migrator)
# Used exclusively by drizzle-kit migration runner.
MIGRATION_DATABASE_URL=postgres://ownlight_migrator:password@127.0.0.1:5432/ownlight_dev

# ------------------------------------------------------------------------------
# Data Retention Configuration
# ------------------------------------------------------------------------------
# Default audit event retention window in months
RETENTION_PERIOD_MONTHS=24

# Retention period for withdrawn consent proof in months (GDPR Art. 7(1) proof)
CONSENT_PROOF_RETENTION_MONTHS=36

# Retention period for inactive clients in months (GDPR Art. 5(1)(e) storage limitation)
CLIENT_RETENTION_MONTHS=36

# ------------------------------------------------------------------------------
# Local Development Service Credentials (used by Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_DB=ownlight_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres_superuser_password
POSTGRES_APP_USER=ownlight_app
POSTGRES_APP_PASSWORD=changeme_app_password
POSTGRES_MIGRATOR_USER=ownlight_migrator
POSTGRES_MIGRATOR_PASSWORD=changeme_migrator_password
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Mailpit for dev)
# ------------------------------------------------------------------------------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Mailpit web UI port (for viewing captured development emails)
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# ------------------------------------------------------------------------------
# S3-Compatible Object Storage (MinIO for dev)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PORT=9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=changeme_storage_access_key
STORAGE_SECRET_KEY=changeme_storage_secret_key
STORAGE_BUCKET_UPLOADS=ownlight-uploads
STORAGE_USE_SSL=false

# MinIO ports (API and Web Console)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# Third-Party Integrations & Credential Vault (ADR-0014)
# ------------------------------------------------------------------------------
# Dedicated 32-byte master key for encrypting third-party tokens and secrets at rest.
# MUST be 32 bytes (64 hex characters or 44 base64 characters).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Studio-Owned Google OAuth 2.0 Web Application credentials (ADR-0008, ADR-0014)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Client-Safe Environment Variables (Exposed to the browser via NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Public application URL accessible by client browsers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default UI locale ('en' | 'de')
NEXT_PUBLIC_DEFAULT_LOCALE=en
